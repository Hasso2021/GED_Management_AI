# Copier vers .env (racine) et/ou services/demo-api/.env


DATA_DIR=data
LOG_LEVEL=INFO
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Intégration Nuxeo expérimentale (optionnelle)
# Laisser vide si vous testez uniquement l'analyse et la validation humaine.
NUXEO_URL=http://localhost:8080/nuxeo
NUXEO_USERNAME=Administrator
NUXEO_PASSWORD=
NUXEO_DOCUMENT_ID=00000000-0000-0000-0000-000000000000
NUXEO_TIMEOUT_SECONDS=15

# Chemin du modèle TF-IDF (optionnel). S'il est absent, la classification
# utilise le repli par mots-clés.
# MODEL_PATH=services/demo-api/models/classifier.joblib
